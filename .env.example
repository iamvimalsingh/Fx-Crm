APP_NAME="Forex Broker CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://fx-crm-brown.vercel.app

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Managed MySQL Database Configuration
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=your-managed-db-host.com
DB_PORT=3306
DB_DATABASE=your_crm_database
DB_USERNAME=your_crm_db_user
DB_PASSWORD=your_secure_db_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=
SESSION_DRIVER=database
SESSION_LIFETIME=120

# S3 / Cloudflare R2 / AWS S3 Object Storage Configuration (For Production on Vercel)
# Set FILESYSTEM_DISK=s3 when using S3-compatible cloud object storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# -----------------------------------------------------------------------------
# Broker White-Label Configuration (Neutral Placeholders)
# -----------------------------------------------------------------------------
BROKER_NAME="Forex Broker CRM"
BROKER_SHORT_NAME="BrokerCRM"
BROKER_LOGO_URL="/assets/img/logo.svg"
BROKER_LOGO_DARK_URL="/assets/img/logo-dark.svg"
BROKER_FAVICON_URL="/assets/img/favicon.ico"
BROKER_SUPPORT_EMAIL="support@your-cpanel-domain.com"
BROKER_SUPPORT_PHONE="+1 (800) 555-0199"
BROKER_BASE_CURRENCY="USD"
BROKER_DEFAULT_COUNTRY="US"

# Trading Platform External URLs
TRADING_WEB_TRADER_URL="https://webtrader.your-cpanel-domain.com"
TRADING_ANDROID_APP_URL="https://play.google.com/store/apps"
TRADING_IOS_APP_URL="https://apps.apple.com"
TRADING_WINDOWS_DESKTOP_URL="https://downloads.your-cpanel-domain.com/setup.exe"
TRADING_MAC_DESKTOP_URL="https://downloads.your-cpanel-domain.com/setup.dmg"

# Feature Flags
FEATURE_DEPOSITS_ENABLED=true
FEATURE_WITHDRAWALS_ENABLED=true
FEATURE_KYC_REQUIRED=true
FEATURE_INTERNAL_TRANSFERS_ENABLED=true
FEATURE_DEMO_ACCOUNTS_ENABLED=true

# Monetary Limits
MIN_DEPOSIT_AMOUNT=10.00
MAX_DEPOSIT_AMOUNT=50000.00
MIN_WITHDRAWAL_AMOUNT=20.00
MAX_WITHDRAWAL_AMOUNT=25000.00
