# -----------------------------------------------------------------------------
# Netlify-Native Forex Broker CRM Environment Variables
# -----------------------------------------------------------------------------
APP_NAME="Forex Broker CRM"
APP_ENV=production
APP_URL=https://your-crm.netlify.app

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Neon / Supabase)
# -----------------------------------------------------------------------------
# PostgreSQL connection string (REQUIRED in production).
# In production, missing or failing database will throw immediately with HTTP 503.
# In-memory fallback is strictly prohibited in production.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Secret key used to sign JWT tokens (minimum 32 characters, REQUIRED in production).
# Default fallback is strictly disabled in production.
JWT_SECRET=

# One-time setup secret for initial administrator account provisioning (REQUIRED in production).
ADMIN_SETUP_SECRET=

# -----------------------------------------------------------------------------
# Persistent Object Storage (AWS S3 / Cloudflare R2 / DigitalOcean Spaces)
# -----------------------------------------------------------------------------
# S3-compatible credentials (REQUIRED in production for document uploads).
# Local/in-memory file fallback is strictly rejected in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=

# -----------------------------------------------------------------------------
# Transactional Email (SMTP / Mailgun / Postmark / SendGrid)
# -----------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Broker Configuration (Neutral Defaults)
# -----------------------------------------------------------------------------
BROKER_NAME="Forex Broker CRM"
BROKER_SHORT_NAME="BrokerCRM"
BROKER_LOGO_URL="/assets/img/logo.svg"
BROKER_LOGO_DARK_URL="/assets/img/logo-dark.svg"
BROKER_FAVICON_URL="/assets/img/favicon.ico"
BROKER_SUPPORT_EMAIL=
BROKER_SUPPORT_PHONE=
BROKER_BASE_CURRENCY="USD"
BROKER_DEFAULT_COUNTRY="US"

# Trading Platform External URLs
TRADING_WEB_TRADER_URL=
TRADING_ANDROID_APP_URL=
TRADING_IOS_APP_URL=
TRADING_WINDOWS_DESKTOP_URL=
TRADING_MAC_DESKTOP_URL=

# Feature Flags
FEATURE_DEPOSITS_ENABLED=true
FEATURE_WITHDRAWALS_ENABLED=true
FEATURE_KYC_REQUIRED=true
FEATURE_INTERNAL_TRANSFERS_ENABLED=true
FEATURE_DEMO_ACCOUNTS_ENABLED=true

# Monetary Limits
MIN_DEPOSIT_AMOUNT=10.00
MAX_DEPOSIT_AMOUNT=50000.00
MIN_WITHDRAWAL_AMOUNT=20.00
MAX_WITHDRAWAL_AMOUNT=25000.00
