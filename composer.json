{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Laravel 11 CRM",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "egulias/email-validator": "^4.0",
        "laravel/framework": "^11.0",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "laravel/app/",
            "Database\\Factories\\": "laravel/database/factories/",
            "Database\\Seeders\\": "laravel/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "laravel/tests/"
        }
    },
    "scripts": {
        "vercel": "cd laravel && composer install --no-dev --prefer-dist --optimize-autoloader"
    },
    "config": {
        "vendor-dir": "laravel/vendor",
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
